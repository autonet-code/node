# Autonet daemon container: the full ATN Runtime (keystore, vault, event
# gossip, federated close, chain submission, tool_guard execution).
#
# Supersedes the pre-substrate Dockerfile.node (moved to
# legacy/pre-substrate/, it ran the dissolved nodes.core.node roles).
#
# Build from the repo root:
#   docker build -f docker/Dockerfile.daemon -t autonet-daemon .
#
# State lives on ONE volume at /data/atn (the daemon's ~/.atn: config.yaml,
# keystore, vault, agents, world state, carry-over files). The image's
# ~/.atn is a symlink to it, so the root filesystem can stay read-only.
# The search model is part of the image (/opt/atn/models, ATN_MODEL_DIR);
# the daemon only checks its hashes at start.
#
# Ports: only one leaves the container.
#   AUTONET_P2P_PORT (4001) - libp2p event gossip / blob transfer.
# The local owner WS (:7700) binds 127.0.0.1 inside the container and is
# deliberately NOT exposed. An agent harness reaches it from inside the
# container through the agent API on 127.0.0.1:7702 (atn/agent_api.py), e.g.
# `docker exec <ctr> curl -s localhost:7702/`.
#
# Compose snippet (hardened):
#
#   services:
#     autonet-node:
#       build:
#         context: .
#         dockerfile: docker/Dockerfile.daemon
#       volumes:
#         - atn-data:/data/atn
#       ports:
#         - "4001:4001"            # libp2p (public)
#       environment:
#         AUTONET_RPC_URL: ${AUTONET_RPC_URL}
#         AUTONET_SUBSTRATE_ADDRESS: ${AUTONET_SUBSTRATE_ADDRESS}
#       cap_drop: [ALL]
#       security_opt: ["no-new-privileges:true"]
#       read_only: true
#       tmpfs:
#         - /tmp:rw,noexec,nosuid,size=256m
#       pids_limit: 512
#       restart: unless-stopped
#   volumes:
#     atn-data:

# ---- build stage: compile wheels that need a toolchain (libp2p deps) ----
FROM python:3.11-slim-bookworm AS build

RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential libgmp-dev \
    && rm -rf /var/lib/apt/lists/*

RUN python -m venv /opt/venv
ENV PATH=/opt/venv/bin:$PATH \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /src
COPY pyproject.toml README.md LICENSE ./
COPY atn/ atn/
COPY nodes/ nodes/
COPY bridge/ bridge/
RUN pip install --upgrade pip setuptools wheel \
    && pip install .

# The local search model (atn/search_model.py): downloaded and checked
# against its pinned sha256 hashes here, so a container starts with semantic
# search on instead of fetching 90 MB on its first run. The build fails if a
# hash does not match.
RUN python -m atn.search_model --fetch /opt/atn/models

# ---- runtime stage ----
FROM python:3.11-slim-bookworm

RUN apt-get update \
    && apt-get install -y --no-install-recommends libgmp10 tini \
    && rm -rf /var/lib/apt/lists/*

ARG ATN_UID=10001
RUN groupadd --system --gid ${ATN_UID} atn \
    && useradd --system --uid ${ATN_UID} --gid atn \
       --home-dir /home/atn --create-home --shell /usr/sbin/nologin atn \
    && mkdir -p /data/atn \
    && chown atn:atn /data/atn \
    && chmod 0700 /data/atn /home/atn \
    && ln -s /data/atn /home/atn/.atn

COPY --from=build /opt/venv /opt/venv
COPY --from=build /opt/atn/models /opt/atn/models

ENV PATH=/opt/venv/bin:$PATH \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    HOME=/home/atn \
    KEYSTORE_DIR=/data/atn/keystore \
    ATN_DATA_DIR=/data/atn \
    XDG_CACHE_HOME=/tmp/cache \
    ATN_AUTO_UPDATE=0 \
    ATN_MODEL_DIR=/opt/atn/models \
    AUTONET_P2P_PORT=4001

VOLUME ["/data/atn"]
EXPOSE 4001

WORKDIR /home/atn
USER atn

# tini reaps the tool_guard / worker subprocesses.
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["atn", "--headless"]
